rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMember(familyId) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(familyId)).data.memberIds;
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /families/{familyId} {
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow read: if isMember(familyId);
      allow update: if isMember(familyId)
        || (signedIn()
            && !(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in request.resource.data.memberIds
            && request.resource.data.memberIds.size() == resource.data.memberIds.size() + 1
            && request.resource.data.memberIds.hasAll(resource.data.memberIds)
            && request.resource.data.lastJoinCode is string
            && exists(/databases/$(database)/documents/pairingCodes/$(request.resource.data.lastJoinCode))
            && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.lastJoinCode)).data.familyId == familyId
            && get(/databases/$(database)/documents/pairingCodes/$(request.resource.data.lastJoinCode)).data.expiresAt > request.time);
      allow delete: if isMember(familyId);

      match /lists/{listId} {
        allow read, write: if isMember(familyId);
      }
    }

    match /pairingCodes/{code} {
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn();
      allow update, delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }
  }
}
